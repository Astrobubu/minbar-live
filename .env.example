HOST=127.0.0.1
PORT=4310
PUBLIC_BASE_URL=http://localhost:4310
# Explicit project key only. Live API calls are disabled without this.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-live-transcribe
FILE_TRANSCRIPTION_MODEL=gpt-transcribe
TRANSLATION_MODEL=gpt-4.1-mini
# Required to enable paid live session creation; set your own long random value.
APP_ACCESS_TOKEN=
RECORDING_RETENTION_DAYS=7

# Optional billing; no Stripe API calls until all configured + HTTPS origin.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SESSION_MAX_MINUTES=60
